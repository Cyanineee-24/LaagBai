@implements IDisposable
@inject QuoteState Quote

<aside class="lg:sticky lg:top-24 rounded-2xl bg-white border border-sand p-6 md:p-7 shadow-[0_16px_40px_-20px_rgba(11,110,127,0.3)]">
    <p class="text-[13px] font-bold uppercase tracking-[0.14em] text-teal">Quick quote</p>
    <h3 class="mt-2 font-display font-semibold text-[22px] leading-snug">@Quote.Selected.Name</h3>
    <p class="mt-1 text-[14px] text-muted">@Quote.Selected.Provider · @CebuData.Peso(Quote.Selected.Price) per @Quote.Selected.Unit</p>
    <div class="mt-6 flex items-center justify-between gap-4">
        <span class="text-[15px] font-bold">@Quote.UnitPlural</span>
        <div class="flex items-center gap-1 rounded-full border border-sand-dark p-1">
            <button type="button" @onclick="Quote.Decrement" disabled="@(Quote.Qty <= QuoteState.MinQty)" aria-label="Decrease"
                    class="w-11 h-11 rounded-full text-[22px] font-bold hover:bg-sand-hover cursor-pointer disabled:opacity-30 disabled:cursor-default">−</button>
            <span class="w-10 text-center text-[18px] font-extrabold" aria-live="polite">@Quote.Qty</span>
            <button type="button" @onclick="Quote.Increment" disabled="@(Quote.Qty >= QuoteState.MaxQty)" aria-label="Increase"
                    class="w-11 h-11 rounded-full text-[22px] font-bold hover:bg-sand-hover cursor-pointer disabled:opacity-30 disabled:cursor-default">+</button>
        </div>
    </div>
    <div class="mt-6 pt-5 border-t border-sand flex flex-col gap-2 text-[14px] text-body">
        <div class="flex justify-between"><span>@CebuData.Peso(Quote.Selected.Price) × @Quote.Qty</span><span>@CebuData.Peso(Quote.Subtotal)</span></div>
        @if (Quote.Fee > 0)
        {
            <div class="flex justify-between"><span>Environmental fee (@CebuData.Peso(Quote.Selected.Fee) × @Quote.Qty)</span><span>@CebuData.Peso(Quote.Fee)</span></div>
        }
    </div>
    <div class="mt-4 pt-4 border-t border-sand flex items-end justify-between">
        <span class="font-bold">Estimated total</span>
        <span class="text-[30px] font-extrabold text-teal leading-none">@CebuData.Peso(Quote.Total)</span>
    </div>
    <button type="button" class="mt-6 w-full h-12 rounded-full bg-coral hover:bg-coral-hover text-ink font-bold cursor-pointer transition">Request booking</button>
    <p class="mt-3 text-[12px] text-muted text-center">Operators confirm within 24 hours. No payment yet.</p>
</aside>

@code {
    protected override void OnInitialized() => Quote.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Quote.Changed -= OnChanged;
}
