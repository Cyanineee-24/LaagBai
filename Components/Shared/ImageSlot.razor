@inject IWebHostEnvironment Env

@* Fills its positioned parent with Src (a .jpg, .png or .webp under wwwroot), or a captioned placeholder when there's no such file. *@
@if (HasImage)
{
    <img src="@Assets[Src!]" alt="@Placeholder" class="absolute inset-0 w-full h-full object-cover" />
}
else
{
    <div class="absolute inset-0 flex flex-col items-center justify-center gap-2 p-4 bg-mist text-muted text-center" role="img" aria-label="@Placeholder">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="w-7 h-7 opacity-60" aria-hidden="true">
            <rect x="3" y="4" width="18" height="16" rx="2" />
            <circle cx="9" cy="10" r="1.8" />
            <path d="m21 16-5-5-9 9" />
        </svg>
        <span class="text-[13px] font-semibold max-w-[260px] leading-snug">@Placeholder</span>
    </div>
}

@code {
    private static readonly string[] extensions = [".jpg", ".jpeg", ".png", ".webp"];

    [Parameter] public string? Src { get; set; }
    [Parameter] public string Placeholder { get; set; } = "";

    private bool HasImage =>
        !string.IsNullOrEmpty(Src)
        && extensions.Contains(Path.GetExtension(Src), StringComparer.OrdinalIgnoreCase)
        && Env.WebRootFileProvider.GetFileInfo(Src).Exists;
}
