@page "/plan"
@implements IDisposable
@inject QuoteState Quote

<PageTitle>Plan Your Trip · LaagBai</PageTitle>

<main class="max-w-[1280px] mx-auto px-5 md:px-10 pt-12 pb-24">
    <p class="text-[13px] font-bold uppercase tracking-[0.14em] text-teal">Plan Your Trip</p>
    <h1 class="mt-2 font-display font-semibold text-[36px] md:text-[56px] tracking-tight leading-[1.05] max-w-[760px]">Tours, stays and rides across Cebu</h1>
    <p class="mt-3 text-[17px] text-body max-w-[600px]">Compare local operators, add one to your quote and send a booking request. All prices in Philippine pesos.</p>
    <OfferTabs Class="mt-8" />
    <section class="mt-8 grid lg:grid-cols-[1fr_360px] gap-10 items-start">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 min-w-0">
            @foreach (var o in CebuData.OfferingsOf(Quote.Tab))
            {
                var on = o == Quote.Selected;
                <article class="bg-white rounded-2xl overflow-hidden border-2 flex flex-col transition @(on ? "border-teal" : "border-transparent")">
                    <div class="relative h-[190px] bg-mist">
                        <ImageSlot Src="@o.ImageUrl" Placeholder="@o.PhotoCaption" />
                        <span class="absolute top-4 left-4 inline-flex items-center h-7 px-3 rounded-full text-[12px] font-bold bg-white text-teal pointer-events-none">@o.Tag</span>
                    </div>
                    <div class="p-6 flex flex-col gap-2 flex-1">
                        <p class="text-[13px] font-semibold text-muted">@o.Place</p>
                        <h3 class="font-display font-semibold text-[21px] tracking-tight leading-snug">@o.Name</h3>
                        <p class="text-[13px] font-semibold text-muted">@o.Provider.Name · <span class="text-star">★ @o.Rating</span> (@o.Reviews)</p>
                        <p class="text-[14px] leading-relaxed text-body">@o.Summary</p>
                        <div class="mt-auto pt-4 flex items-end justify-between gap-3">
                            <div><p class="text-[22px] font-extrabold leading-none">@CebuData.Peso(o.Price)</p><p class="mt-1 text-[13px] text-muted">per @o.PriceUnit</p></div>
                            <button type="button" @onclick="() => Quote.Choose(o)"
                                    class="h-11 px-5 rounded-full text-[14px] font-bold cursor-pointer transition @(on ? "bg-teal text-white" : "border border-teal text-teal hover:bg-teal-tint")">@(on ? "In quote" : "Add to quote")</button>
                        </div>
                    </div>
                </article>
            }
        </div>
        <QuoteCard />
    </section>
</main>

@code {
    // ?tab=Stays etc. switches tab (and resets the quote to that tab's first offer).
    [SupplyParameterFromQuery(Name = "tab")] public string? TabParam { get; set; }

    protected override void OnInitialized() => Quote.Changed += OnChanged;

    protected override void OnParametersSet()
    {
        if (TabParam is not null) Quote.SetTab(TabParam);
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Quote.Changed -= OnChanged;
}
