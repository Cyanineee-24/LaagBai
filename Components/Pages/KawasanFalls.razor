@page "/kawasan-falls"
@implements IDisposable
@inject QuoteState Quote

<PageTitle>Kawasan Falls · LaagBai</PageTitle>

<main>
    <section class="max-w-[1280px] mx-auto px-5 md:px-10 pt-6">
        <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-[14px] font-semibold text-muted">
            <a href="/explore" class="hover:text-teal">Explore</a><span>›</span><a href="@SouthHref" class="hover:text-teal">South Cebu</a><span>›</span><span class="text-ink">Kawasan Falls</span>
        </nav>
        <div class="relative mt-4 h-[420px] md:h-[560px] rounded-2xl overflow-hidden bg-teal">
            <div class="absolute inset-0"><ImageSlot Id="kawasan-hero" Placeholder="Hero photo: Kawasan Falls main basin" /></div>
            <div class="absolute inset-0 pointer-events-none bg-linear-to-t from-teal-shade/85 via-teal-shade/20 to-transparent"></div>
            <div class="absolute left-0 right-0 bottom-0 p-6 md:p-12 pointer-events-none">
                <div class="flex gap-2">
                    <span class="inline-flex items-center h-7 px-3 rounded-full text-[12px] font-bold @CebuData.Badge["Nature"]">Nature</span>
                    <span class="inline-flex items-center h-7 px-3 rounded-full text-[12px] font-bold @CebuData.Badge["Adventure"]">Adventure</span>
                </div>
                <h1 class="mt-4 font-display font-semibold text-white text-[40px] md:text-[72px] tracking-tight leading-none">Kawasan Falls</h1>
                <p class="mt-3 text-white/90 text-[16px] md:text-[19px] max-w-[620px]">A three-tiered limestone falls in Matutinao, Badian, and the finish line of Cebu’s best-known canyoneering route.</p>
            </div>
        </div>
    </section>

    <section class="max-w-[1280px] mx-auto px-5 md:px-10 pt-8">
        <dl class="grid grid-cols-2 md:grid-cols-5 gap-3">
            @foreach (var (key, value) in facts)
            {
                <div class="bg-white rounded-2xl border border-sand p-5">
                    <dt class="text-[12px] font-bold uppercase tracking-[0.1em] text-muted">@key</dt>
                    <dd class="mt-1.5 text-[16px] font-bold leading-snug">@value</dd>
                </div>
            }
        </dl>
    </section>

    <section class="max-w-[1280px] mx-auto px-5 md:px-10 pt-16 grid lg:grid-cols-[1fr_380px] gap-10 lg:gap-12 items-start">
        <div class="min-w-0">
            <h2 class="font-display font-semibold text-[28px] md:text-[36px] tracking-tight">Highlights</h2>
            <div class="mt-6 grid sm:grid-cols-2 gap-4">
                @foreach (var (n, title, body) in highlights)
                {
                    <div class="rounded-2xl bg-white border border-sand p-6">
                        <span class="text-[13px] font-extrabold text-coral">@n</span>
                        <h3 class="mt-2 font-display font-semibold text-[18px]">@title</h3>
                        <p class="mt-1.5 text-[15px] leading-relaxed text-body">@body</p>
                    </div>
                }
            </div>

            <h2 class="mt-16 font-display font-semibold text-[28px] md:text-[36px] tracking-tight">Book around Kawasan</h2>
            <OfferTabs Class="mt-6" />
            <div class="mt-6 flex flex-col gap-4">
                @foreach (var o in CebuData.Offers[Quote.Tab].Where(o => o.NearKawasan))
                {
                    var on = o == Quote.Selected;
                    <div class="rounded-2xl bg-white border-2 p-5 md:p-6 flex flex-col sm:flex-row gap-5 transition @(on ? "border-teal" : "border-transparent")">
                        <div class="relative w-full sm:w-[160px] h-[150px] sm:h-[120px] shrink-0 rounded-xl overflow-hidden bg-mist">
                            <ImageSlot Id="@($"offer-{o.Id}")" Placeholder="@o.Photo" />
                        </div>
                        <div class="flex-1 min-w-0 flex flex-col gap-1.5">
                            <div class="flex flex-wrap gap-2"><span class="inline-flex items-center h-6 px-2.5 rounded-full text-[11px] font-bold bg-teal-tint text-teal">@o.Tag</span></div>
                            <h3 class="font-display font-semibold text-[19px]">@o.Name</h3>
                            <p class="text-[13px] font-semibold text-muted">@o.Provider · <span class="text-star">★ @o.Rating</span> (@o.Reviews)</p>
                            <p class="text-[14px] text-body leading-relaxed">@o.Description</p>
                        </div>
                        <div class="sm:text-right flex sm:flex-col items-center sm:items-end justify-between gap-3 shrink-0">
                            <div><p class="text-[22px] font-extrabold text-ink">@CebuData.Peso(o.Price)</p><p class="text-[13px] text-muted">per @o.Unit</p></div>
                            <button type="button" @onclick="() => Quote.Choose(o)"
                                    class="h-11 px-5 rounded-full text-[14px] font-bold cursor-pointer transition @(on ? "bg-teal text-white" : "border border-teal text-teal hover:bg-teal-tint")">@(on ? "In quote" : "Add to quote")</button>
                        </div>
                    </div>
                }
            </div>
        </div>

        <QuoteCard />
    </section>

    <section class="max-w-[1280px] mx-auto px-5 md:px-10 pt-20 pb-24">
        <div class="flex items-end justify-between gap-6 flex-wrap">
            <h2 class="font-display font-semibold text-[28px] md:text-[36px] tracking-tight">More in South Cebu</h2>
            <a href="@SouthHref" class="text-[15px] font-bold text-teal hover:text-teal-dark">See all in South Cebu →</a>
        </div>
        <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var d in CebuData.Get("moalboal", "osmena", "tumalog"))
            {
                <DestinationCard Destination="d" ImageHeight="h-[200px]" Compact />
            }
        </div>
    </section>
</main>

@code {
    private static readonly string SouthHref = CebuData.RegionHref("South Cebu");

    private static readonly (string Key, string Value)[] facts =
    [
        ("Location", "Matutinao, Badian"),
        ("From Cebu City", "3 hrs by Ceres bus"),
        ("Entrance", "₱45 environmental fee"),
        ("Open", "6:00 AM – 5:00 PM"),
        ("Best months", "Dec – May"),
    ];

    private static readonly (string N, string Title, string Body)[] highlights =
    [
        ("01", "Three tiers of falls", "The main 40 m drop is the busiest. Climb past it to the quieter second and third basins."),
        ("02", "Canyoneering finish", "Most canyon tours start upstream in Alegria and end here after jumps of up to 10 m."),
        ("03", "Bamboo rafts", "Local operators pole you right under the cascade for a free shoulder massage."),
        ("04", "Go early", "Tour groups arrive from 10 AM. Arrive at opening for clear water and empty pools."),
    ];

    protected override void OnInitialized() => Quote.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Quote.Changed -= OnChanged;
}
